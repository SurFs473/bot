{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["back-test/**/*.ts", "live/**/*.ts", "core/**/*.ts", "services/**/*.ts", "interfaces/**/*.ts"],
  "exclude": ["node_modules"]
}
